#!/usr/bin/env bash
# Runs the fast debug test suite before pushing Rust changes, so broken code is caught
# in ~20 s locally instead of ~5 min later in Windows CI. Docs-only pushes skip it.
# Enable once per clone: git config core.hooksPath .githooks
# Skip once: git push --no-verify
set -euo pipefail

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
main=$(git rev-parse --verify -q refs/remotes/fork/main || git rev-parse --verify -q refs/remotes/origin/main || true)
rust_re='^(src/|Cargo\.(toml|lock)$|build\.rs$|tests/)'
needs_tests=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # deleting a remote branch
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$remote_sha
  elif [[ -n "$main" ]]; then
    base=$(git merge-base "$local_sha" "$main")
  else
    needs_tests=1; break # no base to diff against: be safe
  fi
  if git diff --name-only "$base" "$local_sha" | grep -Eq "$rust_re"; then
    needs_tests=1; break
  fi
done

if [[ $needs_tests == 1 ]]; then
  echo "pre-push: Rust changes found, running cargo test (skip with --no-verify)" >&2
  cargo test --locked --quiet
fi
